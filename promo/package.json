{
  "name": "standuptimer-promo",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio",
    "sfx": "python3 scripts/make-sfx.py",
    "render": "pnpm sfx && pnpm render:landscape && pnpm render:square && pnpm render:portrait",
    "render:landscape": "remotion render Landscape out/StandUpTimer-16x9.mp4",
    "render:square": "remotion render Square out/StandUpTimer-1x1.mp4",
    "render:portrait": "remotion render Portrait out/StandUpTimer-9x16.mp4",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.529",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "7.0.2"
  }
}
